{
  "name": "ai-interview",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start -H 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "pnpm test:unit",
    "test:unit": "vitest run tests/unit",
    "test:watch": "vitest tests/unit",
    "test:ai": "RUN_AI_EVALS=1 vitest run tests/ai --reporter=verbose",
    "test:ai:report": "RUN_AI_EVALS=1 vitest run tests/ai --reporter=json --outputFile=evals/results/latest.json",
    "test:all": "pnpm test:unit && pnpm typecheck && pnpm build",
    "check": "pnpm test:all"
  },
  "dependencies": {
    "@ai-sdk/openai": "4.0.50",
    "ai": "7.0.83",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "ws": "^8.21.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@types/ws": "^8.18.1",
    "typescript": "7.0.2",
    "vitest": "3.2.4"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.19.0"
}
