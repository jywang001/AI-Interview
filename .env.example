# Server-only credential for real resume/JD material analysis.
# Required by POST /api/materials/parse; interview/report/drill remain Demo.
OPENAI_API_KEY=

# OpenAI-compatible endpoint and model used by the live material-analysis route.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.6-luna

# Reserved for a future live STT adapter. Voice input currently uses Demo/text fallback.
STT_API_KEY=

# Public product copy. These values never contain credentials.
NEXT_PUBLIC_APP_NAME=AI Interview
NEXT_PUBLIC_APP_TAGLINE=把简历里的每一句话，练成经得起追问的回答。
