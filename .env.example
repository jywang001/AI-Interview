# Reserved server-only credential for the live adapter. The current scaffold always uses Demo Provider.
OPENAI_API_KEY=

# Reserved OpenAI-compatible endpoint for future server-side route handlers.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.6-luna

# Optional server-side speech-to-text credential. Browser text fallback remains available when blank.
STT_API_KEY=

# Public product copy. These values never contain credentials.
NEXT_PUBLIC_APP_NAME=AI Interview
NEXT_PUBLIC_APP_TAGLINE=把简历里的每一句话，练成经得起追问的回答。
